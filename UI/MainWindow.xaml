<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaySpace" Height="700" Width="1080" MinHeight="600" MinWidth="900"
        Background="#F4F6FA" FontFamily="Segoe UI" Foreground="#192238">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D8DEEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#192238"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="HaySpace" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Capture and restore your Windows workspace" Foreground="#667085" Margin="0,3,0,0"/>
            </StackPanel>
            <Button x:Name="CaptureButton" Content="Capture workspace" Background="#315CE8" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Profiles" Padding="16,9">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="#E0E5EF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8,4,0,10">
                                <Button x:Name="RefreshProfilesButton" Content="Refresh" Padding="10,4" DockPanel.Dock="Right"/>
                                <TextBlock Text="Saved profiles" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="ProfileList" BorderThickness="0" DisplayMemberPath="ProfileName"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" BorderBrush="#E0E5EF" BorderThickness="1" CornerRadius="8" Padding="18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                                <WrapPanel>
                                    <Button x:Name="LoadButton" Content="Load workspace" Background="#315CE8" Foreground="White" FontWeight="SemiBold"/>
                                    <Button x:Name="NewButton" Content="New"/>
                                    <Button x:Name="EditButton" Content="Edit"/>
                                    <Button x:Name="CloneButton" Content="Clone"/>
                                    <Button x:Name="DeleteButton" Content="Delete"/>
                                    <Button x:Name="MigrationButton" Content="Migration assistant"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button x:Name="ShortcutButton" Content="Create desktop shortcut"/>
                                    <Button x:Name="TaskbarShortcutButton" Content="Add to taskbar"/>
                                    <Button x:Name="ExportProfileButton" Content="Export profile"/>
                                    <Button x:Name="ImportProfileButton" Content="Import profile"/>
                                    <Button x:Name="BackupButton" Content="Backup"/>
                                    <Button x:Name="RestoreButton" Content="Restore backup"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Workspace details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="ProfileSummary" Text="Select a profile to see its details." TextWrapping="Wrap" Foreground="#667085" LineHeight="24"/>
                                <TextBlock Text="Browser URLs are opened during load. Window placement is matched by process and title, with unmatched displays falling back to the primary monitor." TextWrapping="Wrap" Foreground="#667085" Margin="0,20,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Displays" Padding="16,9">
                <Border Background="White" BorderBrush="#E0E5EF" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,14,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button x:Name="RefreshDisplaysButton" Content="Refresh"/>
                            <Button x:Name="RenameDisplayButton" Content="Rename selected"/>
                            <Button x:Name="TestDisplayButton" Content="Test selected"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Connected displays" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListBox x:Name="DisplayList" BorderThickness="0" DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem Header="Settings" Padding="16,9">
                <Border Background="White" BorderBrush="#E0E5EF" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,14,0,0">
                    <StackPanel x:Name="SettingsRoot">
                        <TextBlock Text="Portable data" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Profiles, settings, backups, logs, and shortcuts are stored beside this application." Foreground="#667085" Margin="0,6,0,14"/>
                        <CheckBox x:Name="RunAtLogonCheckBox" Content="Run at user logon and load a workspace for connected displays" Margin="4,4,4,12"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="AppDesktopShortcutButton" Content="Create HaySpace desktop shortcut"/>
                            <Button x:Name="AppTaskbarShortcutButton" Content="Add HaySpace to taskbar"/>
                        </WrapPanel>
                        <Button x:Name="OpenDataFolderButton" Content="Open HaySpace folder" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="#E9EDF5" CornerRadius="5" Padding="10,6" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#475467"/>
        </Border>
    </Grid>
</Window>
